PORT=3000
DB_STORAGE=./data/indexeddb-upload.sqlite
SQL_LOG=0

# ===== 文件接口鉴权（默认 secure，生产必须配置凭据）=====
# secure（默认）：/api/file 下接口要求鉴权（fail-closed：缺凭据一律 401）。
# demo：完全关闭鉴权，仅限本机 / 内网联调。
AUTH_MODE=secure

# Bearer token 白名单，逗号分隔。前端通过 getAuthHeaders/getAuthToken 注入 Authorization: Bearer <token>
FILE_AUTH_TOKEN=

# 同域 Cookie 名（留空表示不启用 Cookie 鉴权）。前端需 axios withCredentials / Worker credentials:'include'。
FILE_AUTH_COOKIE=

# Cookie 值白名单，逗号分隔。仅配置 FILE_AUTH_COOKIE 而不配置本项时，Cookie 分支一律 401。
FILE_AUTH_COOKIE_TOKENS=
