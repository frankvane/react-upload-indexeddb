{
  "name": "indexeddb-upload-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/index.js' --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=80 --test-concurrency=1 tests/**/*.test.js",
    "test:plain": "node --test --test-concurrency=1 tests/**/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/index.js' --test-concurrency=1 tests/**/*.test.js",
    "verify": "npm run test"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "file-type": "^19.6.0",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "react-upload-indexeddb": "file:..",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
