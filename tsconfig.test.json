{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    /* 测试文件只由 vitest 在运行时执行（esbuild 转译，无类型门禁），
       这里用宽松选项让编辑器/Problems 面板不误报，真实类型约束仍由 src 的严格项目保证。 */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/test/setup.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx"
  ],
  "exclude": []
}
