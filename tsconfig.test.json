{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    /* 测试文件只由 vitest 在运行时执行（esbuild 转译，无类型门禁），
       这里放宽未使用变量检查；其余严格选项与 src 保持一致，避免 IDE 误报。 */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/test/setup.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx"
  ],
  "exclude": []
}
