VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# ---- server（server/ 目录，dotenv 或进程环境变量）----
# 分片大小上限（MB），默认 20
CHUNK_MAX_SIZE_MB=20
# CORS 白名单：默认 *（通配不能携带 credentials）；
# 多 origin 逗号分隔，如 https://a.com,https://b.com
CORS_ORIGIN=*
# 限流：默认开启（300 次/分钟/IP），RATE_LIMIT_ENABLED=false 关闭
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
# 孤儿分片清理：tmp/upload 中超过 TMP_TTL_HOURS（默认 24h）的文件被删除，
# JANITOR_INTERVAL_HOURS（默认 6h）为扫描间隔
TMP_TTL_HOURS=24
JANITOR_INTERVAL_HOURS=6
# 文件接口鉴权（默认关闭）：REQUIRE_FILE_AUTH=true 后配置
# FILE_AUTH_TOKEN=bearer-token-1,bearer-token-2
# FILE_AUTH_COOKIE=portal_token
